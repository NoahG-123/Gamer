{
  "name": "found",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev web -p 4127",
    "build:web": "next build web",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:web && npm run build:electron",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "generate:dressing": "node scripts/generate-dressing.mjs",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux dir --config electron-builder.yml"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "^5.6.0"
  }
}
