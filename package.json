{
  "name": "found",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev web -p 4127",
    "build:web": "next build web",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:web && npm run build:electron",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "node --test tests/api.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "generate:dressing": "node scripts/generate-dressing.mjs",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux dir --config electron-builder.yml",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "extract:icons": "node scripts/extract-icons.mjs",
    "generate:wallpaper": "node scripts/make-wallpaper.mjs",
    "make:icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.341",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/vscode-icons": "^1.2.77",
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.7",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "^5.6.0"
  }
}
