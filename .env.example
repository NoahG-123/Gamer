# Copy to .env (never commit .env). Read by the local server at startup.

# DeepSeek V3 key, via OpenRouter (openrouter.ai/keys). Without it, contacts never
# reply (messages stay on one grey tick). This is the only model that answers messages
# or email; nothing else stands in for it. Starts with "sk-or-".
DEEPSEEK_API_KEY=

# OpenAI key. Draws the portraits and the weather/news pictures on first run. Not used
# for replies.
OPENAI_API_KEY=

# Pixabay keys (free, pixabay.com/api/docs). Fill in the stock photography and stock video:
# wallpapers, backgrounds, some of the widgets-board news photos, and real footage for the
# junk video files scattered around the filesystem (in place of the silent placeholder).
PIXABAY_API_KEY=
PIXABAY_API_KEY_VIDEOS=

# Pexels key (optional). Only used as a fallback if Pixabay is not set or comes up empty.
PEXELS_API_KEY=

# Google AI Studio key (optional). Generates the spoken lines in the recordings
# (npm run fetch:voices). It is not used for images.
GEMINI_API_KEY=

# Hard spend cap in USD across the whole install. Calls stop once estimated spend reaches this. Default 10.
LLM_BUDGET_USD=10

# deepseek (default) | mock - mock returns canned replies with no network, for testing.
LLM_PROVIDER=deepseek

# Optional overrides
# DEEPSEEK_API_BASE=https://openrouter.ai/api/v1   # only the test suite points this elsewhere
# LLM_DEFAULT_MODEL=deepseek-chat   # V3. Avoid reasoning models here - they write essays, not texts.
# LLM_TIMEOUT_MS=120000
# IMAGE_MODEL=gpt-image-1           # gpt-image-2 is slower and better
# IMAGE_QUALITY=medium              # low | medium | high
