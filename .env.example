# Copy to .env (never commit .env). Read by the local server at startup.

# DeepSeek API key. Without it, LLM-driven contacts never reply (messages stay on one grey tick).
DEEPSEEK_API_KEY=

# Hard spend cap in USD across the whole install. Calls stop once estimated spend reaches this. Default 10.
LLM_BUDGET_USD=10

# deepseek (default) | mock — mock returns canned replies with no network, for testing.
LLM_PROVIDER=deepseek

# Optional overrides
# DEEPSEEK_API_BASE=https://api.deepseek.com
# LLM_DEFAULT_MODEL=deepseek-reasoner
# LLM_TIMEOUT_MS=120000
