# Copy to .env (never commit .env). Read by the local server at startup.

# DeepSeek API key. Without it, and without GEMINI_API_KEY below, contacts never reply
# (messages stay on one grey tick).
DEEPSEEK_API_KEY=

# Google AI Studio key. Used for the spoken lines in the recordings, and as a stand-in for
# replies whenever DeepSeek is missing or not answering, so people still get back to you.
GEMINI_API_KEY=

# Hard spend cap in USD across the whole install. Calls stop once estimated spend reaches this. Default 10.
LLM_BUDGET_USD=10

# deepseek (default) | mock — mock returns canned replies with no network, for testing.
LLM_PROVIDER=deepseek

# Optional overrides
# DEEPSEEK_API_BASE=https://api.deepseek.com
# For OpenRouter: DEEPSEEK_API_BASE=https://openrouter.ai/api/v1 (key goes in DEEPSEEK_API_KEY,
# and character `model` fields take OpenRouter slugs like deepseek/deepseek-r1)
# LLM_DEFAULT_MODEL=deepseek-chat   # V3. Avoid reasoning models here — they write essays, not texts.
# LLM_TIMEOUT_MS=120000
# LLM_FALLBACK_MODEL=gemini-2.5-flash   # the stand-in used when DeepSeek is unavailable
PEXELS_API_KEY=
