# Copy to .env (never commit .env). Read by the local server at startup.

# DeepSeek API key, from platform.deepseek.com. Without it, and without a stand-in key
# below, contacts never reply (messages stay on one grey tick).
# This talks to DeepSeek's own API directly. A key beginning "sk-or-" is an OpenRouter
# key and will be rejected here.
DEEPSEEK_API_KEY=

# OpenAI key. Three jobs: it draws the portraits and the weather/news pictures on first
# run, and it stands in for replies whenever DeepSeek is missing or not answering, so
# people still get back to you.
OPENAI_API_KEY=

# Pexels key (optional). Fills in the stock photography: wallpapers and backgrounds.
PEXELS_API_KEY=

# Google AI Studio key (optional). Generates the spoken lines in the recordings
# (npm run fetch:voices). It is not used for images.
GEMINI_API_KEY=

# Hard spend cap in USD across the whole install. Calls stop once estimated spend reaches this. Default 10.
LLM_BUDGET_USD=10

# deepseek (default) | mock - mock returns canned replies with no network, for testing.
LLM_PROVIDER=deepseek

# Optional overrides
# DEEPSEEK_API_BASE=https://api.deepseek.com   # only the test suite points this elsewhere
# LLM_DEFAULT_MODEL=deepseek-chat   # V3. Avoid reasoning models here - they write essays, not texts.
# LLM_TIMEOUT_MS=120000
# LLM_FALLBACK_MODEL=gpt-4.1-mini   # the OpenAI stand-in used when DeepSeek is unavailable
# IMAGE_MODEL=gpt-image-1           # gpt-image-2 is slower and better
# IMAGE_QUALITY=medium              # low | medium | high
